{
  "description": "Check for synchronized configuration updates without applying changes.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/check-update.sh\"",
            "commandWindows": "pwsh -NoProfile -File \"$env:PLUGIN_ROOT\\scripts\\check-update.ps1\"",
            "timeout": 10,
            "statusMessage": "Checking Codex Sync"
          }
        ]
      }
    ]
  }
}
