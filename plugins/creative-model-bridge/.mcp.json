{
  "mcpServers": {
    "creative-model-bridge-bundled": {
      "command": "./scripts/bootstrap.sh",
      "args": ["serve"],
      "cwd": ".",
      "env_vars": [
        "CODEX_HOME",
        "CREATIVE_MODEL_API_KEY",
        "SSL_CERT_FILE",
        "CREATIVE_MODEL_BRIDGE_SSL_CERT_FILE",
        "CREATIVE_MODEL_BRIDGE_BIN",
        "CREATIVE_MODEL_BRIDGE_VERSION",
        "CREATIVE_MODEL_BRIDGE_OFFLINE"
      ]
    }
  }
}
