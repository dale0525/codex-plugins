#!/bin/sh
set -eu

PLUGIN_ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
if ! command -v pixi >/dev/null 2>&1; then
  echo "creative-model-bridge requires pixi to provide Python >=3.11" >&2
  exit 127
fi
export PYTHONDONTWRITEBYTECODE=1

# Pixi normally creates a `.pixi` prefix beside its manifest.  Installed Codex
# plugin caches can be read-only, so stage the audited manifest and lockfile in
# a private writable temporary directory while keeping the server source in the
# copied plugin itself.
RUNTIME_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/creative-model-bridge.XXXXXX")
# shellcheck disable=SC2329
cleanup() {
  rm -rf "$RUNTIME_ROOT"
}
# shellcheck disable=SC2329
forward_signal() {
  status="$1"
  signal="$2"
  if [ -n "${child_pid:-}" ]; then
    kill "-$signal" "$child_pid" 2>/dev/null || :
    wait "$child_pid" 2>/dev/null || :
  fi
  exit "$status"
}
child_pid=
trap cleanup EXIT
trap 'forward_signal 130 INT' INT
trap 'forward_signal 143 TERM' TERM
cp "$PLUGIN_ROOT/pixi.toml" "$RUNTIME_ROOT/pixi.toml"
cp "$PLUGIN_ROOT/pixi.lock" "$RUNTIME_ROOT/pixi.lock"
set +e
# POSIX shells commonly connect asynchronous commands to /dev/null. Preserve
# the MCP stdio stream explicitly while still keeping the child addressable for
# signal forwarding and status capture.
exec 3<&0
pixi run --manifest-path "$RUNTIME_ROOT/pixi.toml" --locked --no-progress python -B -u "$PLUGIN_ROOT/mcp/server.py" "$@" <&3 &
child_pid=$!
wait "$child_pid"
status=$?
child_pid=
exec 3<&-
set -e
exit "$status"
